# =============================================================================
# Social Messaging (Instagram / Facebook DM integration)
# Set ENABLE_SOCIAL_MESSAGING=true to turn this feature on.
# When disabled, the webhook endpoint still responds to Meta's verification
# ping but the dashboard page and API routes are hidden.
# =============================================================================
ENABLE_SOCIAL_MESSAGING=true

# --- Meta / Facebook App credentials ---
# Create an app at https://developers.facebook.com
# Then generate a Page Access Token from the Messenger > Settings panel.
META_VERIFY_TOKEN=your_verify_token_here
META_PAGE_ACCESS_TOKEN=your_page_access_token_here
META_APP_SECRET=your_app_secret_here
